# AURA Fashion Environment Variables
# In production on Render, configure these in the Render Environment tab.

NODE_ENV=production
# PORT is dynamically assigned by Render (e.g. 10000); defaults to 3000 locally
PORT=3000

# Standalone Admin Password Authentication
# Server dynamically checks process.env['AURA-admin'], AURA_ADMIN_PASSWORD, AURA_ADMIN, and ADMIN_PASSWORD.
# Replace with your secret password in Render Environment settings (never hardcode in code).
AURA_ADMIN_PASSWORD=your_super_secret_admin_password_here
SESSION_SECRET=long_random_session_secret_at_least_32_chars_for_cookie_signing

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key
# The service role key is strictly backend-only. Never expose it in client HTML/JS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# GitHub 'aura-data' Image CDN Integration
# Create a fine-grained GitHub token with 'Contents: Read and Write' repository permissions
GITHUB_TOKEN=ghp_your_fine_grained_personal_access_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_MAIN_BRANCH=main
GITHUB_DATA_BRANCH=aura-data

# Optional Anti-Abuse CAPTCHA (Cloudflare Turnstile)
# If provided, the /api/checkout endpoint enforces server-side verification
TURNSTILE_SECRET_KEY=""
